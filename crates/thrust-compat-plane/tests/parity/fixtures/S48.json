{
  "binds": {
    "full_issue": {
      "exchange": "an urgent work item with an assignee, dates and a state",
      "path": [
        "id"
      ]
    },
    "html_issue": {
      "exchange": "a description with markup the pin cleans",
      "path": [
        "id"
      ]
    },
    "issue": {
      "exchange": "the journey's work item",
      "path": [
        "id"
      ]
    }
  },
