        "method": "POST",
        "path": "/api/workspaces/journey-ws/projects/<uuid:1>/issues/"
      },
      "response": {
        "body": {
          "detail": "Authentication credentials were not provided."
        },
        "headers": {
          "content-type": "application/json"
        },
        "status": 401
      }
    },
