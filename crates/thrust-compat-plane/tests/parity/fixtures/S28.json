{
  "binds": {
    "asset": {
      "exchange": "the project cover, as the app sends it",
      "path": [
        "asset_id"
      ]
    },
    "issue_desc": {
      "exchange": "an entity type: ISSUE_DESCRIPTION",
      "path": [
        "asset_id"
      ]
    },
    "named": {
      "exchange": "a name with a directory, a space and a letter outside ASCII",
      "path": [
        "asset_id"
      ]
    },
    "other_asset": {
      "exchange": "a cover in the other workspace",
      "path": [
        "asset_id"
      ]
    },
    "pending": {
      "exchange": "a second cover, which is never uploaded",
      "path": [
        "asset_id"
      ]
    },
    "spare": {
      "exchange": "no name, type or size: the defaults",
      "path": [
        "asset_id"
      ]
    }
  },
