{
  "_comment": "Shared self-test for the two normalisers (tools/compat-record/normalise.py and tests/common/normalise.rs). Each case is a list of raw exchanges and the exchanges they must normalise to, under normalise.json. Spelled out by hand: the expected side is NOT produced by either implementation.",
  "cases": [
    {
      "name": "ids are numbered by first appearance across path, request and response; a dashless id is the same id",
      "input": [
        {
          "name": "ids",
          "request": {"method": "GET", "path": "/api/workspaces/11111111-1111-1111-1111-111111111111/"},
          "response": {
            "status": 200,
            "headers": {"Content-Type": "application/json", "Date": "Sat, 24 Oct 2026 21:18:43 GMT"},
            "body": {
              "workspace": "11111111111111111111111111111111",
              "id": "22222222-2222-2222-2222-222222222222",
              "a": "22222222-2222-2222-2222-222222222222"
            }
          }
        }
      ],
      "expected": [
        {
          "name": "ids",
          "request": {"method": "GET", "path": "/api/workspaces/<uuid:1>/"},
          "response": {
            "status": 200,
            "headers": {"content-type": "application/json"},
            "body": {"a": "<uuid:2>", "id": "<uuid:2>", "workspace": "<uuid:1>"}
          }
        }
      ]
    },
    {
      "name": "a timestamp is replaced only when its key is time-like and its value parses; null stays null",
      "input": [
        {
          "name": "times",
          "request": {"method": "GET", "path": "/t"},
          "response": {
            "status": 200,
            "headers": {},
            "body": {
              "created_at": "2026-10-24T21:18:30.163418Z",
              "deleted_at": null,
              "updated_at": "not a time",
              "start_date": "2026-10-24",
              "name_at_home": "2026-10-24T00:00:00Z",
              "last_active": "2026-10-24T21:18:30Z"
            }
          }
        }
      ],
      "expected": [
        {
          "name": "times",
          "request": {"method": "GET", "path": "/t"},
          "response": {
            "status": 200,
            "headers": {},
            "body": {
              "created_at": "<ts>",
              "deleted_at": null,
              "last_active": "<ts>",
              "name_at_home": "2026-10-24T00:00:00Z",
              "start_date": "<date>",
              "updated_at": "not a time"
            }
          }
        }
      ]
    },
    {
      "name": "opaque paths are replaced by their token, and only at that exact path; null stays null",
      "input": [
        {
          "name": "opaque",
          "request": {"method": "GET", "path": "/api/instances/"},
          "response": {
            "status": 200,
            "headers": {"Content-Type": "application/json"},
            "body": {
              "config": {"admin_base_url": "http://localhost:18080", "enable_signup": true},
              "instance": {
                "instance_id": "587f3aa0b72090b6909ea9ac",
                "current_version": "1.4.2",
                "latest_version": null,
                "is_setup_done": true
              },
              "other": {"instance_id": "kept", "admin_base_url": "kept"}
            }
          }
        }
      ],
      "expected": [
        {
          "name": "opaque",
          "request": {"method": "GET", "path": "/api/instances/"},
          "response": {
            "status": 200,
            "headers": {"content-type": "application/json"},
            "body": {
              "config": {"admin_base_url": "<base_url>", "enable_signup": true},
              "instance": {
                "current_version": "<version>",
                "instance_id": "<opaque>",
                "is_setup_done": true,
                "latest_version": null
              },
              "other": {"admin_base_url": "kept", "instance_id": "kept"}
            }
          }
        }
      ]
    },
    {
      "name": "array elements are walked, and an id inside a longer string is found",
      "input": [
        {
          "name": "arrays",
          "request": {"method": "GET", "path": "/list"},
          "response": {
            "status": 200,
            "headers": {},
            "body": {
              "items": [
                {"id": "33333333-3333-3333-3333-333333333333", "url": "/x/33333333-3333-3333-3333-333333333333/y"},
                {"id": "44444444-4444-4444-4444-444444444444", "url": "/x/not-an-id-33333333-3333-3333-3333-33333333333/y"}
              ]
            }
          }
        }
      ],
      "expected": [
        {
          "name": "arrays",
          "request": {"method": "GET", "path": "/list"},
          "response": {
            "status": 200,
            "headers": {},
            "body": {
              "items": [
                {"id": "<uuid:1>", "url": "/x/<uuid:1>/y"},
                {"id": "<uuid:2>", "url": "/x/not-an-id-33333333-3333-3333-3333-33333333333/y"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ids carry over between exchanges of one fixture; a request body is normalised; only whitelisted headers are kept",
      "input": [
        {
          "name": "first",
          "request": {"method": "POST", "path": "/p", "body": {"form": {"email": "a@example.test"}}},
          "response": {
            "status": 201,
            "headers": {"Retry-After": "30", "Set-Cookie": "s=1", "X-Frame-Options": "DENY"},
            "body": {"id": "55555555-5555-5555-5555-555555555555"}
          }
        },
        {
          "name": "second",
          "request": {"method": "PATCH", "path": "/p/55555555-5555-5555-5555-555555555555/", "body": {"parent": "66666666-6666-6666-6666-666666666666"}},
          "response": {"status": 204}
        }
      ],
      "expected": [
        {
          "name": "first",
          "request": {"method": "POST", "path": "/p", "body": {"form": {"email": "a@example.test"}}},
          "response": {"status": 201, "headers": {"retry-after": "30"}, "body": {"id": "<uuid:1>"}}
        },
        {
          "name": "second",
          "request": {"method": "PATCH", "path": "/p/<uuid:1>/", "body": {"parent": "<uuid:2>"}},
          "response": {"status": 204, "headers": {}, "body": null}
        }
      ]
    }
  ]
}
