 "model": {
  "foundations": {
   "csrf+session-form-flow": {
    "days": 4.0,
    "what": "GET /auth/get-csrf-token/, form-POST sign-in/sign-up/sign-out with 302 + ?error_code=...&error_message=... + next_path validation, rate limits, session cookie 'session-id'",
    "where": "authentication/views/app/*, authentication/adapter/error.py, authentication/rate_limit.py"
   },
   "error-bodies": {
    "days": 1.0,
    "what": "three error shapes: DRF {detail}, project {error}, serializer {field:[msgs]}; map core errors onto them (status codes included)",
    "where": "app/views/base.py handle_exception, authentication/adapter/exception.py (anchors in shapes-anchors.json)"
   },
   "expand-fields-projection": {
    "days": 2.0,
    "what": "?expand= / ?fields= serializer projection (BaseViewSet.fields/expand)",
    "where": "app/views/base.py fields/expand properties"
   },
   "group-by-engine": {
    "days": 6.0,
    "what": "group_by / sub_group_by listing incl. m2m FIELD_MAPPER (labels/assignees/modules), window-function paging per group, per-group total_results, group value enumeration",
    "where": "utils/paginator.py GroupedOffsetPaginator/SubGroupedOffsetPaginator, utils/grouper.py"
   },
   "issue-filter-parser": {
    "days": 6.0,
    "what": "work item filter machinery shared by every issue listing: legacy query params (25 names, issue_filters.py) AND the rich JSON `filters` tree (ComplexFilterBackend, max depth 5), order_by, sub_issue, expand, fields",
    "where": "utils/issue_filters.py (463 lines), utils/filters/* , utils/order_queryset.py"
   },
   "pagination-envelope": {
    "days": 2.0,
    "what": "cursor 'value:offset:is_prev', per_page cap 1000, envelope {grouped_by, sub_grouped_by, total_count, next_cursor, prev_cursor, next_page_results, prev_page_results, count, total_pages, total_results, extra_stats, results}",
    "where": "utils/paginator.py BasePaginator.paginate"
   },
   "presigned-asset-flow": {
    "days": 3.0,
    "what": "POST create asset -> presigned POST/PUT (object store) -> PATCH confirm; GET -> 302 redirect to presigned URL; bulk/restore/duplicate",
    "where": "app/views/asset/v2.py"
   },
   "route-scaffold+authn": {
    "days": 3.0,
    "what": "axum router mounted under /api, /auth, /api/public, /api/instances; session cookie extraction -> permission seam; role decorator equivalent of @allow_permission (ROLE 5/15/20)",
    "where": "app/permissions/base.py, authentication/session.py"
   },
   "serializer-shape-fidelity": {
    "days": 3.0,
    "what": "oracle-diff iteration on the ~25 hot serializers (IssueSerializer incl. computed counts, ProjectSerializer, UserMeSerializer, WorkspaceSerializer ...): field names, nesting, null vs absent, date formats",
    "where": "app/serializers/*"
   }
