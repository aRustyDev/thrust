# Plane v1 oracle: SYNTHETIC values only. Nothing here is a real credential.
# Every service is bound to loopback by compose.oracle.yml and holds no real data.

# --- Django ---------------------------------------------------------------------------------
DEBUG=0
SECRET_KEY=oracle-synthetic-django-key-not-a-secret
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:18080
GUNICORN_WORKERS=2

# The whole point of this stack: serve the drf-spectacular schema at /api/schema/.
ENABLE_DRF_SPECTACULAR=1

# Huge on purpose so the conformance harness is not throttled. The low limit used to record
# 429 / Retry-After lives on the opt-in `api-ratelimit` service, not here.
API_KEY_RATE_LIMIT=100000/minute

# --- Postgres -------------------------------------------------------------------------------
POSTGRES_USER=plane
POSTGRES_PASSWORD=oracle-synthetic-db
POSTGRES_HOST=plane-db
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:oracle-synthetic-db@plane-db:5432/plane

# --- Valkey ---------------------------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# --- RabbitMQ -------------------------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=oracle-synthetic-mq
RABBITMQ_VHOST=plane

# --- Object store (MinIO-compatible) --------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=oracle-access-key
AWS_SECRET_ACCESS_KEY=oracle-secret-key-synthetic
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
USE_MINIO=0
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
# Fork addition (storage.py): "post" is the default and what S3/MinIO use; "put" is for R2.
# Pinned to the default so the oracle records upstream-shaped behaviour. The fork adds `upload_data.method` to upload responses; see the spike 0008 report.
AWS_S3_UPLOAD_METHOD=post

# --- URLs (unused by v1 but read at import time) ----------------------------------------------
WEB_URL=http://localhost:18080
ADMIN_BASE_URL=http://localhost:18080
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=http://localhost:18080
SPACE_BASE_PATH=/spaces
APP_BASE_URL=http://localhost:18080
APP_BASE_PATH=
LIVE_BASE_URL=http://localhost:18080
LIVE_BASE_PATH=/live
LIVE_SERVER_SECRET_KEY=oracle-synthetic-live-key

DOCKERIZED=1
HARD_DELETE_AFTER_DAYS=60

# --- Misc -------------------------------------------------------------------------------------
# Plane's own default; stated explicitly so the oracle does not depend on a settings default.
SKIP_ENV_VAR=1
