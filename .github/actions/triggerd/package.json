{
  "name": "thrust-triggerd",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded selective CI policy evaluator",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile && node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "npm run compile && node scripts/test-runner.mjs",
    "test:fixtures": "npm run compile && node --test test/fixtures.test.mjs",
    "test:coverage": "npm run compile && node --test test/coverage.test.mjs",
    "test:installed": "npm run build && node --test test/installed.test.mjs",
    "test:performance": "npm run compile && node scripts/performance.mjs"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "6.0.1",
    "minimatch": "10.2.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@vercel/ncc": "0.38.4",
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
