#!/bin/sh
# Run any command with the rustup *stable* toolchain first on PATH.
#
# Two environment faults on the dev machine (measured 2026-10-18), both fixed here:
#
# 1. `cargo`/`rustc` on PATH are Homebrew's 1.98.1, which ships no wasm32 std, while rustup's
#    stable (1.99.0) has the wasm32-unknown-unknown target. `rustup run stable cargo` does NOT
#    fix it: cargo still resolves a bare `rustc` through PATH and finds Homebrew's.
#    Fix = put the rustup toolchain bin dir first.
#
# 2. rustup 1.99.0's `rust-lld` aborts at link time with
#      dyld: Library not loaded: @rpath/libLLVM.dylib
#    because libLLVM.dylib sits in <toolchain>/lib, which is not on rust-lld's rpath.
#    Fix = DYLD_FALLBACK_LIBRARY_PATH (set here, after /bin/sh started, because SIP strips
#    DYLD_* from the environment of SIP-protected binaries such as /bin/sh).
#
#   scripts/rs cargo check --target wasm32-unknown-unknown
#   scripts/rs worker-build --release
set -eu
rustc_path="$(rustup which --toolchain stable rustc)"
bindir="$(dirname "$rustc_path")"
libdir="$(dirname "$bindir")/lib"
PATH="$bindir:$HOME/.cargo/bin:$PATH"
DYLD_FALLBACK_LIBRARY_PATH="$libdir${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
export PATH DYLD_FALLBACK_LIBRARY_PATH
exec "$@"
