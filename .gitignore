# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# mdBook output (docs/)
docs/book/

# wrangler / worker-build scratch
.wrangler/
node_modules/
crates/thrust-worker/build/
crates/thrust-editor-worker/build/
# throwaway copies of a wrangler config that a script writes limits or ids into (scripts/worker-dev.sh, scripts/spike-0002-pg.sh)
crates/thrust-worker/.wrangler.run-*.toml
crates/thrust-worker/.wrangler.pg.run.toml
# what scripts/render-wrangler.sh makes from wrangler.deploy.toml: ids of a real environment, never committed
crates/thrust-worker/.wrangler.deploy.run.toml
# the files the deploy uploads as the web app: this release's build with the previous release's added (scripts/merge-assets.sh)
crates/thrust-worker/.assets/
.dev.vars
.dev.vars.*
.env
__pycache__/

# web/ (the stock React app, web/SOURCE): build output, tool caches, and the one source file the build generates
# (the pin ignores it too, .gitignore:116 at oracle/v1-pin-20261018). Scoped to web/ so no Rust path is touched.
web/**/build/
web/**/dist/
web/**/.turbo/
web/**/.react-router/
web/packages/i18n/src/types/keys.generated.ts
